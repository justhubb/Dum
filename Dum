-- 2. CHARACTER: HUMANOID (ค่าที่ผู้เล่นปรับ/ทำได้ทั้งหมด), PARTS, ATTRIBUTES
-- ========================================================
header("[2. CHARACTER & HUMANOID]")
local char = LP.Character
if char then
    w("Character: " .. char:GetFullName())
    w(attrs(char))
    local hum = char:FindFirstChildOfClass("Humanoid")
    if hum then
        w("--- Humanoid ---")
        w(props(hum, {"Health","MaxHealth","WalkSpeed","JumpPower","JumpHeight","UseJumpPower","HipHeight","AutoRotate","AutoJumpEnabled","PlatformStand","Sit","Jump","RigType","RootPart","FloorMaterial","MoveDirection","DisplayName","DisplayDistanceType","HealthDisplayType","NameDisplayDistance","HealthDisplayDistance","MaxSlopeAngle","BreakJointsOnDeath","RequiresNeck","EvaluateStateMachine","CameraOffset","SeatPart","WalkToPoint","WalkToPart","NameOcclusion"}))
        w(attrs(hum))
        w("--- Humanoid States Enabled ---")
        for _, st in ipairs(Enum.HumanoidStateType:GetEnumItems()) do
            local ok, en = pcall(function() return hum:GetStateEnabled(st) end)
            if ok then w("  " .. tostring(st) .. " = " .. tostring(en)) end
        end
        w("Current State: " .. tostring(hum:GetState()))
        w("--- Playing Animations ---")
        for _, tr in ipairs(hum:GetPlayingAnimationTracks()) do
            w(string.format("  [Track] %s | Id=%s | Priority=%s | Speed=%.2f | Weight=%.2f | Looped=%s",
                tr.Name, tostring(tr.Animation and tr.Animation.AnimationId), tostring(tr.Priority), tr.Speed, tr.WeightCurrent, tostring(tr.Looped)))
        end
    end
    w("--- Character Descendants ---")
    for _, d in ipairs(char:GetDescendants()) do
        tick_yield()
        local line = "  [" .. d.ClassName .. "] " .. d:GetFullName()
        if d:IsA("BasePart") then
            line = line .. " | " .. props(d, {"Position","Size","Anchored","CanCollide","CanTouch","CanQuery","Massless","Transparency","Material","AssemblyLinearVelocity","CollisionGroup","Mass"})
        elseif d:IsA("ValueBase") then
            line = line .. " = " .. serialize(d.Value)
        elseif d:IsA("Animation") then
            line = line .. " | Id=" .. d.AnimationId
        elseif d:IsA("Motor6D") or d:IsA("Weld") or d:IsA("WeldConstraint") then
            line = line .. " | Part0=" .. serialize(d.Part0) .. " Part1=" .. serialize(d.Part1)
        end
        local a = attrs(d)
        if a ~= "" then line = line .. " | " .. a end
        w(line)
    end
else
    w("(ยังไม่มี Character)")
end

-- ========================================================
-- 3. TOOLS / BACKPACK / STARTERPACK (สิ่งที่ผู้เล่นใช้ได้)
-- ========================================================
header("[3. TOOLS & BACKPACK]")
local function dumpTool(tool, tag)
    w(string.format("  [%s Tool] %s", tag, tool:GetFullName()))
    w("    " .. props(tool, {"CanBeDropped","Enabled","ManualActivationOnly","RequiresHandle","ToolTip","Grip","GripPos","TextureId"}))
    local a = attrs(tool)
    if a ~= "" then w("    " .. a) end
    for _, d in ipairs(tool:GetDescendants()) do
        if d:IsA("RemoteEvent") or d:IsA("RemoteFunction") or d:IsA("ValueBase") or d:IsA("Script") or d:IsA("LocalScript") or d:IsA("ModuleScript") or d:IsA("Animation") or d:IsA("Sound") then
            local extra = ""
            if d:IsA("ValueBase") then extra = " = " .. serialize(d.Value) end
            if d:IsA("Animation") then extra = " | Id=" .. d.AnimationId end
            if d:IsA("Sound") then extra = " | Id=" .. d.SoundId end
            w("    [" .. d.ClassName .. "] " .. d:GetFullName() .. extra)
        end
    end
end
if LP:FindFirstChild("Backpack") then
    for _, t in ipairs(LP.Backpack:GetChildren()) do if t:IsA("Tool") then dumpTool(t, "Backpack") end end
end
if char then
    for _, t in ipairs(char:GetChildren()) do if t:IsA("Tool") then dumpTool(t, "Equipped") end end
end
for _, t in ipairs(StarterPack:GetChildren()) do if t:IsA("Tool") then dumpTool(t, "StarterPack") end end


local function refreshUI()
    local on = CFG.Enabled
    UI.toggle.Text = on and "STOP AI" or "START AI"
    UI.toggle.BackgroundColor3 = on and C.red or C.green
    UI.dot.BackgroundColor3 = on and C.green or C.red
    UI.phase.Text = S.phase
    if on and S.house and S.buyAttempts >= 6 and #S.towers == 0 and (os.clock() - S.matchStart) > 20 then
        UI.phase.Text = "Can't place towers yet - read the LOG tab (SPY / refused lines)."
    end
    UI.cash.Text = "$" .. fmt(S.cash)
    UI.inc.Text = string.format("%.1f/s", S.income)
    UI.mode.Text = MODES[CFG.Mode].label:match("^%S+")
    UI.matches.Text = tostring(S.matches)
    UI.actions.Text = tostring(S.actions)
    local el = math.floor(os.clock() - S.start)
    UI.time.Text = string.format("%d:%02d:%02d", math.floor(el / 3600), math.floor(el / 60) % 60, el % 60)

    if S.doorRatio then
        local col = S.doorRatio > 0.6 and C.green or (S.doorRatio > 0.3 and C.amber or C.red)
        UI.doorBar(S.doorRatio, string.format("%s / %s", fmt(S.doorCur), fmt(S.doorMax)), col)
    else
        UI.doorBar(0, "not detected", C.mute)
    end
    local t = S.threat
    UI.threatBar(t, string.format("%d%%", t * 100), t < 0.35 and C.green or (t < 0.65 and C.amber or C.red))

    local w = {}
    if S.arriveIn then w[#w + 1] = "Zombies in " .. S.arriveIn .. "s" end
    if S.waveTimer then w[#w + 1] = "Timer " .. S.waveTimer .. "s" end
    if S.bossWaves then w[#w + 1] = "Boss in " .. S.bossWaves .. " waves" end
    UI.wave.Text = #w > 0 and table.concat(w, "  |  ") or "Wave: no info"
    UI.plan.Text = S.planText

    for key, b in pairs(UI.modeBtns) do
        local sel = key == CFG.Mode
        b.BackgroundColor3 = sel and C.accent or C.panel2
        b.TextColor3 = sel and C.bg or C.text
    end
    UI.modeDesc.Text = MODES[CFG.Mode].desc
    UI.diffBtns.Easy.BackgroundColor3 = (CFG.Difficulty == "Easy") and C.green or C.panel2
    UI.diffBtns.Hard.BackgroundColor3 = (CFG.Difficulty == "Hard") and C.red or C.panel2
    for key, sw in pairs(UI.switches) do
        local v = CFG.Auto[key]
        sw.b.BackgroundColor3 = v and C.green or C.panel2
        sw.knob.Position = v and UDim2.fromOffset(26, 2) or UDim2.fromOffset(2, 2)
    end

    for _, cell in pairs(UI.cells) do
        cell.Text, cell.BackgroundColor3, cell.TextColor3 = "", C.panel2, C.mute
    end
    local known = 0
    for _, e in ipairs(S.towers) do
        if e.x and e.y then
            known = known + 1
            local cell = UI.cells[e.x .. "," .. e.y]
            if cell then
                local d = TOWERS[e.tower]
                cell.Text = d.short .. " L" .. e.level
                cell.BackgroundColor3 = (d.role == "eco") and C.eco or C.def
                cell.TextColor3 = C.text
            end
        end
    end
    local cardParts = {}
    for tower, c in pairs(S.cards) do
        cardParts[#cardParts + 1] = TOWERS[tower].name .. " $" .. tostring(c.cost)
    end
    UI.boardInfo.Text = string.format("Towers: %d (eco %d / def %d), cells known: %d\nMethod: %s\nCards: %s",
        #S.towers, S.ecoPlaced, S.defPlaced, known, (CFG.Auto.Cards and S.placeMethod == "card") and "build cards" or "direct PlaceTower",
        #cardParts > 0 and table.concat(cardParts, " | ") or "none found")

    if logDirty then
        logDirty = false
        UI.logLbl.Text = table.concat(logLines, "\n")
        UI.logPage.CanvasPosition = Vector2.new(0, 1e6)
    end
end


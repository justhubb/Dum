local function endScreen()
    local pg = LP:FindFirstChild("PlayerGui")
    if not pg then return false end
    for _, g in ipairs(pg:GetChildren()) do
        if g:IsA("ScreenGui") and g.Enabled then
            local n = string.lower(g.Name)
            if string.find(n, "result", 1, true) or string.find(n, "gameover", 1, true)
                or string.find(n, "victory", 1, true) or string.find(n, "defeat", 1, true)
                or string.find(n, "endscreen", 1, true) then
                return true
            end
        end
    end
    local b = findGui("PlayAgain")
    return (b and isShown(b)) and true or false
end

local function maybeReplay()
    if not CFG.Auto.Replay then return end
    local now = os.clock()
    local ended = endScreen()
    if now - S.lastReplay > (ended and 2 or 25) then
        S.lastReplay = now
        if fire("PlayAgain") and ended then
            S.phase = "Match ended - play again"
            log("Play again")
        end
    end
end

local function resetMatch(house)
    S.towers, S.usedCells, S.badCells, S.buyLock = {}, {}, {}, {}
    S.doorUps, S.doorLock, S.doorFails = 0, 0, 0
    S.matchStart = os.clock()
    S.triedHouses = {}
    S.matches = S.matches + 1
    S.lastDmgT, S.threat, S.lastSpeed, S.prevDoor = 0, 0.25, 0, nil
    S.cardsLogged, S.cardFails, S.buyAttempts, S.noCellNote = false, 0, 0, false
    log("New match - house " .. tostring(house))
end

local function lobbyStep()
    if not CFG.Auto.Lobby then
        S.phase = "Lobby (auto queue off)"
        return
    end
    local pg = LP:FindFirstChild("PlayerGui")
    if not pg then return end
    local remotes = RS:FindFirstChild("Remotes")
    local partyUI = pg:FindFirstChild("PartyUI")
    local main = partyUI and partyUI:FindFirstChild("Main")
    local telep = partyUI and partyUI:FindFirstChild("Teleporter")
    local isParty = (main and main.Visible) or (telep and telep.Value ~= nil)

    if isParty then
        local obj = telep and telep.Value
        if obj and remotes and remotes:FindFirstChild("Start") then
            pcall(function() remotes.Start:FireServer(obj, 4, false) end)
        end
        if main and main.Visible then
            local startBtn = main:FindFirstChild("Start")
            if startBtn and startBtn.Visible and firesignal then
                pcall(function()
                    firesignal(startBtn.Activated)
                    firesignal(startBtn.MouseButton1Click)
                end)
            end
        end
        S.phase = "[Lobby] Starting match..."
    elseif os.clock() - S.lastQueue > 2.5 then
        if remotes and remotes:FindFirstChild("QuickPlay") then
            pcall(function() remotes.QuickPlay:FireServer(CFG.Difficulty) end)
            S.lastQueue = os.clock()
            S.phase = "[Lobby] Queuing: " .. CFG.Difficulty
        end
    end
end

local function gameStep()
    if not RS:FindFirstChild("TowerDefenseRemotes") then
        S.phase = "Waiting for game remotes..."
        return
    end
    local claimed = LP:GetAttribute("ClaimedHouseName")
    if not claimed or claimed == "" then
        S.house = nil
        S.phase = "Looking for a free house..."
        if CFG.Auto.Claim and os.clock() - S.lastClaim > 1.0 then
            claimHouse()
            S.lastClaim = os.clock()
        end
        maybeReplay()
        return
    end
    if claimed ~= S.house then
        S.house = claimed
        resetMatch(claimed)
    end

    if CFG.Auto.Speed and os.clock() - S.lastSpeed > 20 then
        S.lastSpeed = os.clock()
        fire("SpeedToggle", true)
    end

    if not S.cardsLogged and next(S.cards) ~= nil then
        S.cardsLogged = true
        local parts = {}
        for tower, c in pairs(S.cards) do
            parts[#parts + 1] = string.format("#%d %s $%s count=%s", c.idx, tower, tostring(c.cost), c.count)
        end
        log("Build cards: " .. table.concat(parts, " | "))
    end

    S.phase = string.format("Thinking... (%s)", MODES[CFG.Mode].label)
    if CFG.Auto.Repair then tryRepair() end

    local c = decide()
    if c then perform(c) end
    maybeReplay()
end

local function brainStep()
    hookCash()
    S.cash = getCash()
    S.income = getIncome()
    if game.PlaceId == INGAME_PLACE_ID then
        readHud()
        S.cards = readCards()
        updateThreat()
    end
    if not CFG.Enabled then
        S.phase = "Paused"
        return
    end
    if game.PlaceId == LOBBY_PLACE_ID then
        lobbyStep()
    elseif game.PlaceId == INGAME_PLACE_ID then
        gameStep()
    else
        S.phase = "Unknown place"
    end
end


local function fmtArg(v, depth)
    local t = typeof(v)
    if t == "string" then
        return '"' .. v .. '"'
    elseif t == "table" then
        if depth > 1 then return "{...}" end
        local parts, n = {}, 0
        for k, val in pairs(v) do
            n = n + 1
            if n > 6 then
                parts[#parts + 1] = "..."
                break
            end
            parts[#parts + 1] = tostring(k) .. "=" .. fmtArg(val, depth + 1)
        end
        return "{" .. table.concat(parts, ",") .. "}"
    elseif t == "Instance" then
        return v.Name
    end
    return tostring(v)
end

ENV.__AI_TD_SPYFN = function(remote, method, ...)
    if not alive() then return end
    local parent = remote.Parent
    if not parent or (parent.Name ~= "TowerDefenseRemotes" and parent.Name ~= "Remotes") then return end
    local args = { ... }
    local rname = remote.Name
    if rname == "PlaceTower" then
        S.lastPlace = { tower = args[1], x = args[2], y = args[3], t = os.clock() }
    elseif rname == "UpgradeTower" then
        local a1, a2 = args[1], args[2]
        if type(a1) == "number" and type(a2) == "number" then S.upVar, S.upShapeKnown = 1, true
        elseif typeof(a1) == "Vector2" then S.upVar, S.upShapeKnown = 2, true
        elseif type(a1) == "table" then S.upVar, S.upShapeKnown = 3, true
        elseif type(a1) == "string" and type(a2) == "number" then S.upVar, S.upShapeKnown = 4, true end
    end
    local parts = {}
    for i = 1, select("#", ...) do parts[i] = fmtArg(args[i], 0) end
    local msg = "SPY " .. rname .. "(" .. table.concat(parts, ", ") .. ")"
    if msg ~= S.lastSpy or os.clock() - S.lastSpyT > 0.6 then
        S.lastSpy, S.lastSpyT = msg, os.clock()
        log(msg)
    end
end

if hookmetamethod and getnamecallmethod and not ENV.__AI_TD_HOOKED then
    ENV.__AI_TD_HOOKED = true
    pcall(function()
        local old
        local function hook(self, ...)
            local m = getnamecallmethod()
            if (m == "FireServer" or m == "InvokeServer") and ENV.__AI_TD_SPYFN
                and not (checkcaller and checkcaller()) then
                pcall(ENV.__AI_TD_SPYFN, self, m, ...)
            end
            return old(self, ...)
        end
        old = hookmetamethod(game, "__namecall", newcclosure and newcclosure(hook) or hook)
    end)
end


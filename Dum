local yieldCount = 0
local function tick_yield()
    yieldCount += 1
    if yieldCount % 2500 == 0 then task.wait() end
end

local function serialize(v)
    local t = typeof(v)
    if t == "Vector3" then return string.format("V3(%.3f, %.3f, %.3f)", v.X, v.Y, v.Z) end
    if t == "Vector2" then return string.format("V2(%.3f, %.3f)", v.X, v.Y) end
    if t == "Color3" then return string.format("RGB(%d,%d,%d)", math.floor(v.R*255), math.floor(v.G*255), math.floor(v.B*255)) end
    if t == "UDim2" then return string.format("UDim2(%.3f,%d,%.3f,%d)", v.X.Scale, v.X.Offset, v.Y.Scale, v.Y.Offset) end
    if t == "UDim" then return string.format("UDim(%.3f,%d)", v.Scale, v.Offset) end
    if t == "CFrame" then
        local x, y, z = v.X, v.Y, v.Z
        local rx, ry, rz = v:ToOrientation()
        return string.format("CF(pos=%.2f,%.2f,%.2f rot=%.1f,%.1f,%.1f)", x, y, z, math.deg(rx), math.deg(ry), math.deg(rz))
    end
    if t == "Instance" then return v:GetFullName() end
    if t == "EnumItem" then return tostring(v) end
    if t == "NumberRange" then return string.format("NR(%s..%s)", v.Min, v.Max) end
    if t == "Rect" then return string.format("Rect(%s -> %s)", serialize(v.Min), serialize(v.Max)) end
    if t == "table" then
        local parts = {}
        for k, val in pairs(v) do parts[#parts + 1] = tostring(k) .. "=" .. tostring(val) end
        return "{" .. table.concat(parts, ", ") .. "}"
    end
    return tostring(v)
end

-- อ่านรายการ property ของอ็อบเจกต์ (ข้ามตัวที่ error)
local function props(obj, list)
    local out = {}
    for _, name in ipairs(list) do
        local ok, val = pcall(function() return obj[name] end)
        if ok and val ~= nil then
            out[#out + 1] = name .. "=" .. serialize(val)
        end
    end
    return table.concat(out, " | ")
end

local function attrs(obj)
    local parts = {}
    local ok, a = pcall(function() return obj:GetAttributes() end)
    if ok then
        for k, v in pairs(a) do parts[#parts + 1] = k .. "=" .. serialize(v) .. "(" .. typeof(v) .. ")" end
    end
    return #parts > 0 and ("Attrs{" .. table.concat(parts, ", ") .. "}") or ""
end

local function tags(obj)
    local ok, t = pcall(function() return CollectionService:GetTags(obj) end)
    return (ok and #t > 0) and ("Tags[" .. table.concat(t, ",") .. "]") or ""
end

local function header(title)

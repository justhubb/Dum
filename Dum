-- 8. WORKSPACE: PROMPTS / CLICKDETECTORS / SEATS / TOUCH / TOOLS / SPAWNS / TELEPORT
-- ========================================================
header("[8. WORKSPACE INTERACTIVES]")
local function partPos(o)
    local par = o.Parent
    if par and par:IsA("BasePart") then return serialize(par.Position) end
    if par and par:IsA("Attachment") then return serialize(par.WorldPosition) end
    if par and par:IsA("Model") then
        local ok, cf = pcall(function() return par:GetPivot() end)
        if ok then return serialize(cf.Position) end
    end
    return "N/A"
end
for _, obj in ipairs(Workspace:GetDescendants()) do
    tick_yield()
    if obj:IsA("ProximityPrompt") then
        w(string.format("  [Prompt] %s | Action=%s | Object=%s | Key=%s | Hold=%.2f | MaxDist=%.1f | Enabled=%s | LoS=%s | Exclusivity=%s | Pos=%s | Path=%s %s %s",
            obj.Name, obj.ActionText, obj.ObjectText, tostring(obj.KeyboardKeyCode), obj.HoldDuration, obj.MaxActivationDistance,
            tostring(obj.Enabled), tostring(obj.RequiresLineOfSight), tostring(obj.Exclusivity), partPos(obj), obj:GetFullName(), attrs(obj), tags(obj)))
    elseif obj:IsA("ClickDetector") then
        w(string.format("  [ClickDetector] %s | MaxDist=%.1f | Pos=%s | Path=%s %s", obj.Name, obj.MaxActivationDistance, partPos(obj), obj:GetFullName(), attrs(obj)))
    elseif obj:IsA("DragDetector") then
        w(string.format("  [DragDetector] %s | Pos=%s | Path=%s", obj.Name, partPos(obj), obj:GetFullName()))
    elseif obj:IsA("Seat") or obj:IsA("VehicleSeat") then
        w(string.format("  [%s] %s | Disabled=%s | Pos=%s | Path=%s", obj.ClassName, obj.Name, tostring(obj.Disabled), serialize(obj.Position), obj:GetFullName()))
    elseif obj:IsA("SpawnLocation") then
        w(string.format("  [Spawn] %s | Pos=%s | Enabled=%s | Team=%s | Path=%s", obj.Name, serialize(obj.Position), tostring(obj.Enabled), tostring(obj.TeamColor), obj:GetFullName()))
    elseif obj:IsA("Tool") then
        w("  [WorldTool] " .. obj:GetFullName() .. " " .. attrs(obj))
    elseif obj:IsA("TouchTransmitter") then
        w("  [TouchInterest] " .. obj:GetFullName() .. " | Pos=" .. partPos(obj))
    elseif obj:IsA("Sound") and obj.Playing then
        w("  [PlayingSound] " .. obj:GetFullName() .. " | Id=" .. obj.SoundId)
    elseif obj:IsA("ValueBase") then
        -- แสดงในหมวด 6 แล้ว
    else
        local a = attrs(obj)
        if a ~= "" then w("  [AttrObj:" .. obj.ClassName .. "] " .. obj:GetFullName() .. " | " .. a) end
    end
end


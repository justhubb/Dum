-- every cash DROP is a spend (income only adds), so real prices are measured from drops
local spendLog, hookedCash, cashLast, cashConn = {}, nil, 0, nil
local function hookCash()
    local c = getCashObj()
    if not c or c == hookedCash then return end
    hookedCash = c
    cashLast = c.Value
    if cashConn then cashConn:Disconnect() end
    cashConn = c.Changed:Connect(function(v)
        if v < cashLast then
            spendLog[#spendLog + 1] = { t = os.clock(), a = cashLast - v }
            if #spendLog > 40 then table.remove(spendLog, 1) end
        end
        cashLast = v
    end)
end
local function spentSince(t0)
    local s = 0
    for _, e in ipairs(spendLog) do
        if e.t >= t0 then s = s + e.a end
    end
    return s
end
local function waitSpend(t0, window)
    local deadline = os.clock() + window
    while os.clock() < deadline do
        task.wait(0.05)
        if spentSince(t0) > 0 then
            task.wait(0.08)
            return spentSince(t0)
        end
    end
    return 0
end

local uiCache, uiMiss = {}, {}
local function findGui(name)
    local c = uiCache[name]
    if c and c.Parent then return c end
    if uiMiss[name] and os.clock() < uiMiss[name] then return nil end
    local pg = LP:FindFirstChild("PlayerGui")
    if pg then
        for _, d in ipairs(pg:GetDescendants()) do
            if d.Name == name then
                uiCache[name] = d
                return d
            end
        end
    end
    uiMiss[name] = os.clock() + 4
    return nil
end

local function isShown(obj)
    local pg = LP:FindFirstChild("PlayerGui")
    local o = obj
    while o and o ~= pg and o ~= game do
        if o:IsA("GuiObject") then
            if not o.Visible then return false end
        elseif o:IsA("LayerCollector") then
            if not o.Enabled then return false end
        end
        o = o.Parent
    end
    return true
end

local function textOf(obj)
    if not obj or not isShown(obj) then return nil end
    local parts = {}
    if (obj:IsA("TextLabel") or obj:IsA("TextButton")) and obj.Text ~= "" then
        parts[#parts + 1] = obj.Text
    end
    for _, d in ipairs(obj:GetDescendants()) do
        if (d:IsA("TextLabel") or d:IsA("TextButton")) and d.Text ~= "" and isShown(d) then
            parts[#parts + 1] = d.Text
        end
    end
    if #parts == 0 then return nil end
    return table.concat(parts, " ")
end

local function readHud()
    local a = textOf(findGui("ArrivalToast"))
    S.arriveIn = a and tonumber(string.match(string.upper(a), "ARRIVE IN%s*(%d+)")) or nil

    local tl = textOf(findGui("TimerLabel"))
    S.waveTimer = tl and tonumber(string.match(tl, "(%d+)%s*[sS]")) or nil

    local tt = textOf(findGui("TitleLabel"))
    S.bossWaves = tt and tonumber(string.match(string.upper(tt), "IN:?%s*(%d+)%s*WAVE")) or nil

    local st = textOf(findGui("StatusToast"))
    S.doorHint = (st and string.find(string.upper(st), "UPGRADE DOOR", 1, true)) and true or false

    local hp = textOf(findGui("DoorHpWorldGui")) or textOf(findGui("HpText"))
    local cur, max
    if hp then cur, max = string.match(hp, "([%d%.]+)%s*/%s*([%d%.]+)") end
    cur, max = tonumber(cur), tonumber(max)
    if cur and max and max > 0 then
        S.doorCur, S.doorMax, S.doorRatio = cur, max, math.clamp(cur / max, 0, 1)
        if S.prevDoor and cur < S.prevDoor - 0.01 then S.lastDmgT = os.clock() end
        S.prevDoor = cur
    else
        S.doorCur, S.doorMax, S.doorRatio = nil, nil, nil
    end
end

-- build cards (TowerHudUI.PlacePanel.BuildCardN): tower name + real price straight from the HUD
local function readCards()
    local panel = findGui("PlacePanel")
    local out = {}
    if not panel then return out end
    for _, b in ipairs(panel:GetChildren()) do
        local idx = string.match(b.Name, "^BuildCard(%d+)$")
        if idx and b:IsA("GuiButton") then
            idx = tonumber(idx)
            local nameLbl = b:FindFirstChild("TowerName")
            local nm = (nameLbl and nameLbl:IsA("TextLabel")) and string.upper(nameLbl.Text) or ""
            local tower
            for _, kw in ipairs(TOWER_KEYWORDS) do
                if string.find(nm, kw[1], 1, true) then
                    tower = kw[2]
                    break
                end
            end
            tower = tower or DEFAULT_CARDS[idx]
            if tower then
                local pb = b:FindFirstChild("PriceBox")
                local pl = pb and pb:FindFirstChild("Price")
                local cost = (pl and pl:IsA("TextLabel")) and tonumber((string.gsub(pl.Text, "[^%d]", ""))) or nil
                local cl = b:FindFirstChild("Count")
                out[tower] = {
                    btn = b, cost = cost, idx = idx, name = nm,
                    count = (cl and cl:IsA("TextLabel")) and cl.Text or "",
                }
            end
        end
    end
    return out
end


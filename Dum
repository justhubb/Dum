local function countOf(tower)
    local n = 0
    for _, t in ipairs(S.towers) do
        if t.tower == tower then n = n + 1 end
    end
    return n
end

local function recount()
    local eco, def = 0, 0
    for _, t in ipairs(S.towers) do
        if TOWERS[t.tower].role == "eco" then eco = eco + 1 else def = def + 1 end
    end
    S.ecoPlaced, S.defPlaced = eco, def
end

local function updateThreat()
    local now = os.clock()
    local t = 0.2
    if S.doorRatio then t = t + (1 - S.doorRatio) * 0.6 end
    if S.arriveIn and S.arriveIn <= 8 then t = t + 0.2 end
    if S.waveTimer and S.waveTimer <= 8 and not S.arriveIn then t = t + 0.1 end
    if now - S.lastDmgT < 8 then t = t + 0.2 end
    if S.bossWaves and S.bossWaves <= 1 then t = t + 0.25 end
    if (now - S.matchStart) > 30 and S.defPlaced < 2 then t = math.max(t, 0.65) end
    S.threat = S.threat * 0.75 + math.min(1, t) * 0.25
end

local function weights()
    local m = CFG.Mode
    local we, wd
    if m == "Economy" then we, wd = 1.7, 0.5
    elseif m == "Defense" then we, wd = 0.5, 1.7
    elseif m == "Balanced" then we, wd = 1, 1
    else
        we = 1.7 - 1.3 * S.threat
        wd = 0.45 + 1.4 * S.threat
    end
    -- survival floor: never go without turrets once the first wave is near/here
    if S.defPlaced < 2 and (os.clock() - S.matchStart) > 25 then wd = math.max(wd, 1.8) end
    return we, wd
end

local function upCost(t)
    local d = TOWERS[t.tower]
    local k = "U:" .. t.tower .. ":" .. t.level
    if S.costs[k] then return S.costs[k] end
    local prev = S.costs["U:" .. t.tower .. ":" .. (t.level - 1)]
    if prev then return prev * 1.7 end
    return d.up * (1.7 ^ (t.level - 1))
end

local function describe(c)
    if c.kind == "buy" then
        return string.format("Buy %s #%d", TOWERS[c.tower].name, countOf(c.tower) + 1)
    elseif c.kind == "up" then
        return string.format("Upgrade %s (%d,%d) to L%d", TOWERS[c.entry.tower].name, c.entry.x, c.entry.y, c.entry.level + 1)
    end
    return "Upgrade door"
end

local function buildCandidates()
    recount()
    local we, wd = weights()
    local now = os.clock()
    local list = {}
    local useCards = CFG.Auto.Cards and S.placeMethod == "card"

    if CFG.Auto.Place then
        for tower, d in pairs(TOWERS) do
            local card = S.cards[tower]
            local usable = (useCards and card ~= nil) or not useCards
            local n = countOf(tower)
            if usable and n < d.target and (S.buyLock[tower] or 0) <= now then
                local cost = (card and card.cost) or S.costs["P:" .. tower] or d.cost
                local w = (d.role == "eco") and we or wd
                list[#list + 1] = { kind = "buy", tower = tower, cost = cost, hasCard = card ~= nil,
                    score = w * d.gain / (1 + 0.35 * n) / cost * 100 }
            end
        end
    end

    if CFG.Auto.Upgrade then
        for _, t in ipairs(S.towers) do
            if t.x and t.y and t.level < UP_CAP and (t.lock or 0) <= now then
                local d = TOWERS[t.tower]
                local isEco = d.role == "eco"
                local w = isEco and we or wd
                local frac = isEco and 0.22 or 0.4
                local cost = upCost(t)
                list[#list + 1] = { kind = "up", entry = t, cost = cost, score = w * d.gain * frac / t.level / cost * 100 }
            end
        end
    end

    if CFG.Auto.Door and S.doorLock <= now then
        local cost = S.costs.D or 150
        local val = DOOR_UP_VALUE / (1 + S.doorUps * 0.6) * (1 + (1 - (S.doorRatio or 1)) * 1.5)
        if S.doorHint then val = val * 1.8 end
        list[#list + 1] = { kind = "door", cost = cost, score = wd * val / cost * 100 }
    end
    table.sort(list, function(a, b) return a.score > b.score end)
    return list
end

local function decide()
    local list = buildCandidates()
    if #list == 0 then
        S.phase = "Nothing to buy right now"
        S.planText = "Nothing left to buy"
        return nil
    end
    local lines = {}
    for i = 1, math.min(3, #list) do
        lines[#lines + 1] = string.format("%d) %s  $%d", i, describe(list[i]), list[i].cost)
    end
    S.planText = table.concat(lines, "\n")

    local best = list[1]
    local cash, inc = S.cash, math.max(S.income, 1)
    if best.cost <= cash then return best end

    local eta = (best.cost - cash) / inc
    if eta <= 7 then
        S.phase = string.format("Saving for: %s (%.0fs)", describe(best), eta)
        return nil
    end
    for _, c in ipairs(list) do
        if c.cost <= cash and c.score >= best.score * 0.4 then return c end
    end
    S.phase = "Saving cash..."
    return nil
end

local function nextCell()
    local now = os.clock()
    if now - S.badReset > 60 then
        S.badCells = {}
        S.badReset = now
    end
    for _, c in ipairs(CELLS) do
        local k = c[1] .. "," .. c[2]
        if not S.usedCells[k] and not S.badCells[k] then return c end
    end
    return nil
end

local function performBuy(c)
    local tower = c.tower
    local card = S.cards[tower]
    local method = (CFG.Auto.Cards and S.placeMethod == "card" and card) and "card" or "remote"
    local cash0 = S.cash
    local t0 = os.clock()
    local cell
    S.buyAttempts = S.buyAttempts + 1

    if method == "card" then
        if not clickCard(card.btn) then
            S.placeMethod = "remote"
            log("Can't click build cards on this executor - using direct PlaceTower")
            return
        end
    else
        cell = nextCell()
        if not cell then
            S.buyLock[tower] = os.clock() + 30
            log("No free cell left for " .. TOWERS[tower].name .. " - pause 30s")
            return
        end
        if not fire("PlaceTower", tower, cell[1], cell[2]) then
            S.phase = "PlaceTower remote missing"
            S.buyLock[tower] = os.clock() + 5
            return
        end
    end

    local spent = waitSpend(t0, 0.7)
    local now = os.clock()
    if spent > 0 then
        local x, y
        if cell then
            x, y = cell[1], cell[2]
        elseif S.lastPlace and S.lastPlace.t >= t0 and type(S.lastPlace.x) == "number" then
            x, y = S.lastPlace.x, S.lastPlace.y
        end
        if x then S.usedCells[x .. "," .. y] = true end
        S.towers[#S.towers + 1] = { tower = tower, x = x, y = y, level = 1, fails = 0, lock = 0 }
        S.costs["P:" .. tower] = spent
        S.actions = S.actions + 1
        S.spentTotal = S.spentTotal + spent
        if method == "card" then S.cardWorked, S.cardFails = true, 0 end
        if not x and not S.noCellNote then
            S.noCellNote = true
            log("Tower cell unknown (SPY unavailable) - upgrades need cells. Turn OFF 'Buy with cards' in AUTO to probe cells directly.")
        end
        log(string.format("OK  Buy %s%s  -$%d  [%s]", TOWERS[tower].name, x and string.format(" (%d,%d)", x, y) or "", spent, method))
        return
    end

    -- nothing spent
    local exact = card and card.cost
    local rich = cash0 >= c.cost * (exact and 1.05 or 1.7)
    if not rich then
        if not exact then S.costs["P:" .. tower] = math.max(c.cost, cash0 * 1.2) end
        S.buyLock[tower] = now + 1
        return
    end
    if method == "card" then
        S.cardFails = S.cardFails + 1
        if not S.cardWorked and S.cardFails >= 3 then
            S.placeMethod = "remote"
            log("Build-card click spent nothing 3x - switching to direct PlaceTower probing")
        else
            S.buyLock[tower] = now + 15
            log("Game refused " .. TOWERS[tower].name .. " (grid full / limit?) - retry in 15s")
        end
    else
        S.badCells[cell[1] .. "," .. cell[2]] = true
        S.buyLock[tower] = now + 0.3
        log(string.format("Cell (%d,%d) refused for %s", cell[1], cell[2], TOWERS[tower].name))
    end
end

local function performUp(c)
    local e = c.entry
    local cash0 = S.cash
    local t0 = os.clock()
    if not fire("UpgradeTower", unpack(UP_VARIANTS[S.upVar](e.x, e.y, e.tower))) then
        e.lock = os.clock() + 5
        return
    end
    local spent = waitSpend(t0, 0.6)
    local now = os.clock()
    if spent > 0 then
        S.costs["U:" .. e.tower .. ":" .. e.level] = spent
        e.level, e.fails = e.level + 1, 0
        S.actions = S.actions + 1
        S.spentTotal = S.spentTotal + spent
        if not S.upConfirmed then log("UpgradeTower format #" .. S.upVar .. " works") end
        S.upConfirmed = true
        log(string.format("OK  Upgrade %s (%d,%d) -> L%d  -$%d", TOWERS[e.tower].name, e.x, e.y, e.level, spent))
        return
    end
    if cash0 < c.cost * 1.7 then
        S.costs["U:" .. e.tower .. ":" .. e.level] = math.max(c.cost, cash0 * 1.2)
        e.lock = now + 1
        return
    end
    e.fails = e.fails + 1
    if not S.upConfirmed and not S.upShapeKnown then
        S.upVar = S.upVar % #UP_VARIANTS + 1
        log("UpgradeTower did nothing - trying format #" .. S.upVar)
    end
    e.lock = now + 0.6
    if e.fails >= 4 then
        e.lock, e.fails = now + 45, 0
        log(string.format("(%s) upgrade refused - maxed/locked, retry in 45s", TOWERS[e.tower].name))
    end
end

local function performDoor(c)
    local cash0 = S.cash
    local t0 = os.clock()
    if not fire("UpgradeDoor") then
        S.doorLock = os.clock() + 5
        return
    end
    local spent = waitSpend(t0, 0.6)
    local now = os.clock()
    if spent > 0 then
        S.costs.D = spent
        S.doorUps, S.doorFails = S.doorUps + 1, 0
        S.actions = S.actions + 1
        S.spentTotal = S.spentTotal + spent
        log(string.format("OK  Upgrade door  -$%d", spent))
    elseif cash0 >= c.cost * 1.7 then
        S.doorFails = S.doorFails + 1
        S.doorLock = now + 25
        log("Door upgrade refused (max/locked?) - retry in 25s")
    else
        S.costs.D = math.max(c.cost, cash0 * 1.2)
        S.doorLock = now + 1
    end
end

local function perform(c)
    S.phase = "Buying: " .. describe(c)
    if c.kind == "buy" then performBuy(c)
    elseif c.kind == "up" then performUp(c)
    else performDoor(c) end
end

local function tryRepair()
    if not S.doorRatio or S.doorRatio >= 0.92 then return end
    if S.cash < 10 then return end
    if os.clock() - S.lastRepair < 1.0 then return end
    if not repairReady() then return end
    S.lastRepair = os.clock()
    if fire("RepairDoor") then
        S.repairs = S.repairs + 1
        S.phase = "Repairing door"
        if S.doorRatio < 0.5 then log(string.format("EMERGENCY repair (door %d%%)", S.doorRatio * 100)) end
    end
end

------------------------------------------------------------------
-- HOUSE CLAIM  (touch the house DOOR; houses discovered from the map)
------------------------------------------------------------------
local function isClaimed()
    local c = LP:GetAttribute("ClaimedHouseName")
    return c ~= nil and c ~= ""
end

local function flat(a, b)
    local d = a - b
    return Vector3.new(d.X, 0, d.Z).Magnitude
end

local function pollClaimed(sec)
    local t0 = os.clock()
    while os.clock() - t0 < sec do
        if isClaimed() then return true end
        task.wait(0.08)
    end
    return isClaimed()
end

local function partOf(inst)
    if not inst then return nil end
    if inst:IsA("BasePart") then return inst end
    if inst:IsA("Model") and inst.PrimaryPart then return inst.PrimaryPart end
    return inst:FindFirstChildWhichIsA("BasePart", true)
end

local function findDoor(house)
    local best
    for _, d in ipairs(house:GetDescendants()) do
        local n = string.lower(d.Name)
        if string.find(n, "door", 1, true) and not string.find(n, "hp", 1, true) and not string.find(n, "gui", 1, true) then
            local p = partOf(d)
            if p then
                if d.Name == "Door" then return p end
                best = best or p
            end
        end
    end
    return best
end

local houseCache, houseCacheT = {}, 0
local function discoverHouses()
    if #houseCache > 0 and os.clock() - houseCacheT < 15 then return houseCache end
    local out = {}
    for _, d in ipairs(workspace:GetDescendants()) do
        if (d:IsA("Model") or d:IsA("Folder")) and string.match(d.Name, "^[Hh]ouse%s*_?%d+$") then
            out[#out + 1] = { inst = d, name = d.Name }
        end
    end
    for _, h in ipairs(out) do
        h.door = findDoor(h.inst)
        local p = h.door or partOf(h.inst)
        h.pos = p and p.Position or nil
    end
    houseCache, houseCacheT = out, os.clock()
    return out
end

local function houseTaken(h)
    local others = {}
    for _, pl in ipairs(Players:GetPlayers()) do
        if pl ~= LP then
            others[string.lower(pl.Name)] = true
            others[string.lower(pl.DisplayName)] = true
            others[tostring(pl.UserId)] = true
        end
    end
    local function check(inst)
        for _, v in pairs(inst:GetAttributes()) do
            if (type(v) == "string" or type(v) == "number") and others[string.lower(tostring(v))] then
                return true
            end
        end
        return false
    end
    if check(h.inst) then return true end
    if h.door and check(h.door) then return true end
    return false
end

local function attrString(inst)
    local parts = {}
    for k, v in pairs(inst:GetAttributes()) do
        parts[#parts + 1] = tostring(k) .. "=" .. tostring(v)
    end
    return #parts > 0 and table.concat(parts, ",") or "-"
end

-- walk like a player (pathfinding) - used only when a house has no door part
local function walkTo(pos, timeout)
    local char = LP.Character
    local hum = char and char:FindFirstChildOfClass("Humanoid")
    local hrp = char and char:FindFirstChild("HumanoidRootPart")
    if not hum or not hrp then return false end
    local deadline = os.clock() + timeout
    local points = {}
    local path = PathfindingService:CreatePath({ AgentRadius = 2, AgentHeight = 5, AgentCanJump = true })
    local ok = pcall(function() path:ComputeAsync(hrp.Position, pos) end)
    if ok and path.Status == Enum.PathStatus.Success then
        for _, wp in ipairs(path:GetWaypoints()) do points[#points + 1] = wp end
    end
    if #points == 0 then
        points[1] = { Position = pos, Action = Enum.PathWaypointAction.Walk }
    end
    for _, wp in ipairs(points) do
        if isClaimed() then return true end
        if wp.Action == Enum.PathWaypointAction.Jump then hum.Jump = true end
        hum:MoveTo(wp.Position)
        local t0 = os.clock()
        while os.clock() < deadline and os.clock() - t0 < 2.5 do
            task.wait(0.08)
            if isClaimed() then return true end
            if flat(hrp.Position, wp.Position) < 3 then break end
        end
        if os.clock() >= deadline then break end
    end
    return pollClaimed(0.5)
end

-- go to the door from each side and bump into it (also fires a touch signal directly)
local function approachDoor(door)
    local char = LP.Character
    local hrp = char and char:FindFirstChild("HumanoidRootPart")
    local hum = char and char:FindFirstChildOfClass("Humanoid")
    if not hrp or not hum then return false end

    if firetouchinterest then
        pcall(function()
            firetouchinterest(hrp, door, 0)
            task.wait(0.05)
            firetouchinterest(hrp, door, 1)
        end)
        if pollClaimed(0.4) then return true end
    end

    local floorY = door.Position.Y - door.Size.Y / 2 + 3
    local cf = door.CFrame
    local dirs = { cf.LookVector, -cf.LookVector, cf.RightVector, -cf.RightVector }
    for _, d in ipairs(dirs) do
        local from = door.Position + d * 6
        hrp.CFrame = CFrame.new(Vector3.new(from.X, floorY, from.Z), Vector3.new(door.Position.X, floorY, door.Position.Z))
        task.wait(0.15)
        hum:MoveTo(door.Position)
        if pollClaimed(1.6) then return true end
    end
    hrp.CFrame = door.CFrame
    return pollClaimed(0.6)
end

local fbIdx = 0
local function claimHouse()
    local char = LP.Character
    local hrp = char and char:FindFirstChild("HumanoidRootPart")
    if not hrp then return end

    local houses = discoverHouses()
    local pool = {}
    for _, h in ipairs(houses) do
        if h.pos and not S.triedHouses[h.name] and not houseTaken(h) then pool[#pool + 1] = h end
    end
    if #pool == 0 and #houses > 0 then
        S.triedHouses = {}
        houseCacheT = 0
        for _, h in ipairs(houses) do
            if h.pos and not houseTaken(h) then pool[#pool + 1] = h end
        end
    end

    if #pool == 0 then
        -- no house models found: old coordinates, walking in
        local names = {}
        for n in pairs(HOUSE_FALLBACK) do names[#names + 1] = n end
        table.sort(names)
        fbIdx = fbIdx % #names + 1
        local n = names[fbIdx]
        if not S.scanLogged.none then
            S.scanLogged.none = true
            log("No House models found in workspace - walking to saved coordinates")
        end
        S.phase = "Walking to " .. n .. "..."
        walkTo(HOUSE_FALLBACK[n], 12)
        return
    end

    table.sort(pool, function(a, b) return flat(hrp.Position, a.pos) < flat(hrp.Position, b.pos) end)
    local h = pool[1]
    S.triedHouses[h.name] = true
    if not S.scanLogged[h.name] then
        S.scanLogged[h.name] = true
        log(string.format("%s: door=%s pos=(%d,%d,%d) attrs=%s", h.name, h.door and h.door.Name or "none",
            h.pos.X, h.pos.Y, h.pos.Z, attrString(h.inst)))
    end
    S.phase = "Going to the door of " .. h.name
    local ok
    if h.door then ok = approachDoor(h.door) else ok = walkTo(h.pos, 12) end
    if not ok then log("Claim " .. h.name .. " failed - next house") end
end

